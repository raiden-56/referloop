# ---------------------------------------------------------------------------
# ReferLoop configuration. Copy to `.env` in the repository root.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (docker compose exposes the database on port 5442)
DATABASE_URL=postgresql://referloop:referloop@localhost:5442/referloop?schema=public
# Used only by the API integration tests; this database is wiped by the tests.
TEST_DATABASE_URL=postgresql://referloop:referloop@localhost:5442/referloop_test?schema=public

# Public URL of the web app. Used in emails and in shared job links.
APP_URL=http://localhost:5180
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5180

# Secret used to sign CSRF tokens. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef
SESSION_TTL_HOURS=168
# Defaults to true when NODE_ENV=production. Only disable for plain-HTTP local testing.
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting). 0 = none.
TRUST_PROXY=0
# Serve the built web app (apps/web/dist) from the API. Defaults to true in production.
SERVE_WEB=false

# Email: smtp | console. `console` prints emails (including verification links) to the API log
# and is refused when NODE_ENV=production.
EMAIL_TRANSPORT=smtp
EMAIL_FROM="ReferLoop <no-reply@referloop.local>"
# Development: Mailpit from docker compose (inbox at http://localhost:8025)
# 127.0.0.1 rather than localhost: on some hosts localhost resolves to IPv6 first and SMTP stalls.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Multiplies every rate limit (e.g. 10 for load testing). Keep at 1 in production.
RATE_LIMIT_SCALE=1
